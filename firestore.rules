
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isApproved() {
      return isSignedIn() && userDoc().data.approved == true;
    }

    function isAdmin() {
      return isApproved() && userDoc().data.role == 'admin';
    }

    function isBootstrapAdmin() {
      return isAdmin() && userDoc().data.email == 'yejoon7154@gmail.com';
    }

    function roleChanged() {
      return request.resource.data.role != resource.data.role;
    }

    function approvalChanged() {
      return request.resource.data.approved != resource.data.approved;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isBootstrapAdmin()
        || (isAdmin() && !roleChanged())
        || (isSignedIn() && request.auth.uid == userId && !roleChanged() && !approvalChanged());
      allow delete: if isBootstrapAdmin();
    }

    match /photos/{photoId} {
      allow read: if isApproved();
      allow create: if isApproved();
      allow update: if isApproved() && resource.data.uploadedBy == request.auth.uid;
      allow delete: if isApproved() && resource.data.uploadedBy == request.auth.uid;
    }

    match /chatMessages/{messageId} {
      allow read: if isApproved();

      function chatCoreUnchanged() {
        return request.resource.data.authorUid == resource.data.authorUid
          && request.resource.data.text == resource.data.text
          && request.resource.data.authorName == resource.data.authorName
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.get('replyTo', null) == resource.data.get('replyTo', null);
      }

      allow create: if isApproved()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.authorName is string
        && (!('replyTo' in request.resource.data) || (
          request.resource.data.replyTo is map
          && request.resource.data.replyTo.messageId is string
          && request.resource.data.replyTo.authorName is string
          && request.resource.data.replyTo.text is string
          && request.resource.data.replyTo.text.size() <= 200
        ));

      allow update: if isApproved()
        && chatCoreUnchanged()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['reactions', 'seenBy']);

      allow delete: if isApproved() && resource.data.authorUid == request.auth.uid;
    }

    match /users/{userId}/fcmTokens/{tokenId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /{collection}/{document=**} {
      allow read: if isApproved();
      allow write: if isAdmin();
    }
  }
}
